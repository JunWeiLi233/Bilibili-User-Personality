{
  "version": "1.0",
  "createdAt": "2026-07-07T12:52:31.029Z",
  "description": "3-annotator labeling protocol for Phase 0.1 baseline",
  "annotators": {
    "A1": {
      "role": "balanced",
      "description": "Balanced annotator — scores based on holistic reading"
    },
    "A2": {
      "role": "strict",
      "description": "Strict annotator — scores only with explicit textual evidence"
    },
    "A3": {
      "role": "adjudicator",
      "description": "Adjudicator — resolves A1/A2 disagreements, sees both scores"
    }
  },
  "iaaProtocol": {
    "sharedComments": 200,
    "cohensKappaTarget": 0.61,
    "doubleLabelRate": 0.1,
    "weeklyKappaCheck": true,
    "thresholds": {
      "haltAndRetrain": 0.5,
      "acceptable": 0.7
    },
    "disagreementResolution": "third_adjudicator",
    "goldStandard": {
      "size": 200,
      "description": "200 comments labeled by all 3 annotators + adjudicated, frozen as eval set"
    }
  },
  "labelingSchema": {
    "isRisky": {
      "type": "boolean",
      "description": "Does the comment contain argumentative-behavior markers (attack, extreme language, evasion, malice)?",
      "shortcut": "Y/N"
    },
    "riskAxis": {
      "type": "string",
      "values": [
        "attack",
        "absolutes",
        "evasion",
        "cooperation",
        "correction",
        null
      ],
      "description": "Primary risk axis if isRisky=true",
      "shortcuts": {
        "1": "attack",
        "2": "absolutes",
        "3": "evasion",
        "4": "cooperation",
        "5": "correction",
        "6": "null"
      }
    },
    "sentiment": {
      "type": "string",
      "values": [
        "positive",
        "negative",
        "neutral"
      ],
      "description": "Overall sentiment of the comment",
      "shortcuts": {
        "7": "positive",
        "8": "negative",
        "9": "neutral"
      }
    },
    "isMemeOrQuote": {
      "type": "boolean",
      "description": "Is this a meme reference, quote, or non-original expression?",
      "shortcut": "M"
    },
    "difficult": {
      "type": "boolean",
      "description": "Flag if this comment was particularly difficult to classify",
      "default": false
    }
  },
